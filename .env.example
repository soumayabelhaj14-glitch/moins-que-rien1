# ============================================================
# Moins que rien — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne committez jamais .env dans Git.
# ============================================================

# --- Application ---
NODE_ENV=production
PORT=3000

# --- Supabase Cloud ---
# Depuis : Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://VOTRE_REF_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...      # clé publique (safe côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé secrète (côté serveur UNIQUEMENT, ne jamais exposer)
# Note : VITE_ préfixe requis pour que TanStack Start expose la variable côté client.
# SUPABASE_SERVICE_ROLE_KEY n'a PAS de préfixe VITE_ — elle ne doit JAMAIS être exposée au navigateur.

# --- Supabase PostgreSQL direct (pour pg_dump / sauvegardes) ---
# Depuis : Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:MOT_DE_PASSE@db.VOTRE_REF_PROJET.supabase.co:5432/postgres

# --- SMTP (emails d'authentification) ---
# Recommandé : Brevo (gratuit jusqu'à 300 mails/jour)
# Depuis : Supabase Dashboard > Authentication > SMTP Settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre-email@example.com
SMTP_PASS=VOTRE_CLE_API_BREVO
SMTP_FROM=noreply@votre-domaine.fr

# --- OVH Object Storage S3 (photos — phase 2) ---
# Depuis : OVHcloud Manager > Public Cloud > Object Storage > Credentials S3
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_BUCKET=mqr-photos
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=

# --- Sauvegardes ---
BACKUP_RETENTION_DAYS=14

# --- Identification produit (phase 2 — optionnel) ---
# Laisser vide pour utiliser uniquement les sources gratuites (EAN, Open Library…)
# VISION_API_KEY=       # Google Cloud Vision ou Mistral Vision (accord requis avant activation)
# VISION_PROVIDER=      # "google" | "mistral" (non activé par défaut)
